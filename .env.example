# --- Application ---
APP_NAME=SecureIAM
ENVIRONMENT=development   # development | test | production

# --- Database ---
# Local/dev value matches the postgres service in docker-compose.yml
DATABASE_URL=postgresql+asyncpg://secureiam:secureiam@db:5432/secureiam

# --- JWT ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use this placeholder value outside local development.
JWT_SECRET_KEY=changeme-generate-a-real-secret-with-secrets-token-hex-32
JWT_ALGORITHM=HS256
JWT_ISSUER=secureiam
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# --- Password hashing (Argon2id) ---
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4
